{
  "name": "citadel-emulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser test bench for Bastl Citadel / Kastle 2 firmware DSP (runs the real firmware code as WebAssembly)",
  "scripts": {
    "wasm": "./wasm/build.sh && ./wasm/firmware/build_all.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/copy-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "wasm:dsp": "./wasm/build.sh",
    "wasm:firmware": "./wasm/firmware/build_all.sh",
    "uf2": "./scripts/build-uf2.sh"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
